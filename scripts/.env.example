# Copia este archivo a ".env" (sin .example) y completa tus datos reales.
# El archivo .env NUNCA se sube a git (ver .gitignore).
CHESS_USER=tu_usuario
CHESS_PASS=tu_contraseña
# true = ver el navegador mientras corre (util para calibrar/depurar)
# false = corre en segundo plano, mas rapido
HEADLESS=false
